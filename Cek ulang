<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #fff4e8;
            font-family: Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 30px 20px;
        }

        .card {
            width: 100%;
            max-width: 600px;
            border: 1px solid #ffe0c2;
            border-radius: 15px;
            background-color: #ffffff;
            box-shadow: 0 5px 20px rgba(230, 126, 34, 0.12);
        }

        .card-body {
            padding: 30px;
        }

        h3 {
            color: #8a4510;
            font-weight: bold;
            margin-bottom: 20px;
        }

        .card-body > p {
            color: #9a795e;
            font-size: 16px;
        }

        hr {
            border-color: #f2c9a5;
            margin: 20px 0;
        }

        #daftarproduk {
            background-color: #fffaf5;
            border: 1px solid #f5d2b2;
            border-radius: 10px;
            padding: 20px;
            margin: 15px 0;
        }

        .produk p {
            color: #6b4a32;
            font-size: 15px;
            margin-bottom: 12px;
        }

        .namaproduk,
        .jumlahproduk,
        .hargasatuan,
        .subtotal {
            color: #8a4510;
            font-weight: bold;
        }

        .totalharga {
            color: #e87916;
            font-size: 20px;
            font-weight: bold;
        }

        a {
            text-decoration: none;
        }

        button {
            width: 100%;
            padding: 12px;
            background-color: #f28c28;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
            margin-top: 15px;
        }

        button:hover {
            background-color: #d96d12;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(217, 109, 18, 0.2);
        }

        @media (max-width: 576px) {
            .card-body {
                padding: 22px;
            }

            h3 {
                font-size: 22px;
            }

            .totalharga {
                font-size: 18px;
            }
        }
    </style>
</head>
<body>
    <!--halaman ke-3-->
    <!-- Konfirmasi Pesanan -->
     <div class="card">

        <div class="card-body">
            <h3>Konfirmasi Pesanan</h3>
            <p>Rincian Pesanan:</p><hr>

            <div id="daftarproduk">
                <div clas="produk">
                    <p>Nama produk: <span class="namaproduk"></span></p>
                    <p>Jumlah: <span class="jumlahproduk"></span></p>
                    <p>Harga Satuan: <span class="hargasatuan"></span></p>
                    <p>Subtotal: <span class="subtotal"></span></p>
                </div>
            </div><hr>

            <p><b>Total Harga: <span class="totalharga"></span></b></p>
            <a href="co.html"> 
                <button type="button">Lanjut</button></a>

     </div>
</body>
</html>
