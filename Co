<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #fff4e8;
            font-family: Arial, sans-serif;
            padding: 40px 20px;
        }

        form {
            max-width: 600px;
            margin: auto;
            background-color: #ffffff;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(230, 126, 34, 0.12);
            border: 1px solid #ffe0c2;
        }

        label {
            font-size: 18px;
            font-weight: bold;
            color: #8a4510;
            margin-bottom: 10px;
        }

        .card {
            border: 1px solid #f5d2b2;
            border-radius: 12px;
            background-color: #fffaf5;
            transition: 0.3s;
        }

        .card:hover {
            border-color: #f28c28;
            box-shadow: 0 3px 10px rgba(242, 140, 40, 0.12);
        }

        .card-body {
            padding: 20px;
            color: #51351f;
        }

        input[type="radio"] {
            accent-color: #f28c28;
            width: 17px;
            height: 17px;
            cursor: pointer;
            margin-right: 8px;
        }

        .card-body input[type="radio"] {
            vertical-align: middle;
        }

        .card-body p {
            color: #9a795e;
            font-size: 14px;
            margin-left: 28px;
            margin-top: 5px;
            margin-bottom: 12px;
        }

        hr {
            color: #f2c9a5;
            margin: 15px 0;
        }

        input[type="submit"] {
            width: 100%;
            padding: 13px;
            background-color: #f28c28;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
        }

        input[type="submit"]:hover {
            background-color: #d96d12;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(217, 109, 18, 0.2);
        }
    </style>
</head>
<body>
    <!--halaman ke-4-->

    <form action="">
        <!-- Metode Pembayaran -->
        <label for="method">Metode Pembayaran</label><br>
        <div class="card">
            <div class="card-body ">
                <input type="radio" name="method" value="transfer">Transfer <br><hr>
                <input type="radio" name="method" value="tunai">Tunai <br>
            </div>
        </div><br>

    <!-- Pemilihan Ekspedisi -->
        <label for="ekspedisi">Pengantaran</label><br>
        <div class="card">
            <div class="card-body">
                <input type="radio" name="ekspedisi" value="prioritas">Solitare<br>
                <p>Tiba dalam beberapa jam</p><hr>
                <input type="radio" name="ekspedisi" value="standar">Prioritas<br>
                <p>Dikirim besok</p><hr>
                <input type="radio" name="ekspedisi" value="hemat">Ekonomi
                <p>1-2 hari</p>
            </div>
        </div><br>   

        <input type="submit" value="Check Out">
    </form>

</body>
</html>
